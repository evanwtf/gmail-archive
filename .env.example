# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every host-specific value in this project lives here; nothing committed to the
# repository names a machine, a path outside the project, or a core count.

# --- required ----------------------------------------------------------------
# Password for the dedicated Postgres container. Any long random string; it is
# only reachable over the compose network. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- paths (host side) -------------------------------------------------------
# Where the content-addressed blob store lives. This is the bulk of the archive
# — budget for the size of the mbox export itself, plus extracted attachments.
# Put it on local disk with compression and snapshots if you have them; no
# network filesystem, ever.
GMAIL_ARCHIVE_BLOB_HOST_PATH=./data/blobs

# Which database the app reads. Normally leave this alone. It exists so a
# rebuild (see docs/runbook.md) can be cut over by pointing at the new
# database and blob store, and rolled back by pointing at the old ones —
# rather than by destroying anything.
GMAIL_ARCHIVE_DB=gmail_archive

# Directory containing the Takeout .mbox file(s), mounted read-only at /mbox in
# the ingest container.
MBOX_HOST_DIR=./data/mbox

# --- tuning ------------------------------------------------------------------
# Parse worker processes. Empty means os.cpu_count().
GMAIL_ARCHIVE_WORKERS=

# Messages per COPY batch. Empty means the built-in default.
GMAIL_ARCHIVE_BATCH_SIZE=

# --- web ---------------------------------------------------------------------
# Host port for the UI. Published on 127.0.0.1 only; the UI has no
# authentication of its own.
WEB_PORT=8000

GMAIL_ARCHIVE_LOG_LEVEL=INFO

# Set to 1 ONLY if a reverse proxy sits in front of the UI. It makes the login
# throttle read the last hop of X-Forwarded-For instead of the connecting
# address, so one client's failed guesses stop locking out everyone behind the
# proxy. Leave it off otherwise: without a proxy, the header is attacker-
# controlled and trusting it means nobody is ever throttled.
GMAIL_ARCHIVE_TRUST_PROXY=

# --- IMAP server ---------------------------------------------------------------
# Password for the read-only IMAP server. Required to start the IMAP server.
# The username defaults to "archive"; set with --user on the CLI.
GMAIL_ARCHIVE_IMAP_PASSWORD=

# --- build metadata (set by the build, not by hand) --------------------------
# Surfaced at /version and by `gmail-archive version`.
GMAIL_ARCHIVE_VERSION=
GMAIL_ARCHIVE_COMMIT=
GMAIL_ARCHIVE_BUILD_TIME=

# Host port for the read-only IMAP server, published on 127.0.0.1 only.
# Start it with: docker compose --profile imap up -d imap
IMAP_PORT=1143

# --- web authentication --------------------------------------------------------
# scrypt hash of the web UI password. Generate with:
#   uv run gmail-archive set-password
# Empty means NO AUTHENTICATION — anyone who can reach WEB_PORT can read the
# entire archive, and the port is published on all interfaces by default.
GMAIL_ARCHIVE_WEB_PASSWORD_HASH=

# --- image ---------------------------------------------------------------------
# Which published image to run. Pinned rather than floating: the schema changes
# between versions and nothing migrates it for you. Override to build locally.
GMAIL_ARCHIVE_IMAGE=evandhoffman/gmail-archive
GMAIL_ARCHIVE_IMAGE_TAG=0.2.8
