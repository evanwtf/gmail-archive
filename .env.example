# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every host-specific value in this project lives here; nothing committed to the
# repository names a machine, a path outside the project, or a core count.

# --- required ----------------------------------------------------------------
# Password for the dedicated Postgres container. Any long random string; it is
# only reachable over the compose network. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- paths (host side) -------------------------------------------------------
# Where the content-addressed blob store lives. This is the bulk of the archive
# — budget for the size of the mbox export itself, plus extracted attachments.
# Put it on local disk with compression and snapshots if you have them; no
# network filesystem, ever.
GMAIL_ARCHIVE_BLOB_HOST_PATH=./data/blobs

# Directory containing the Takeout .mbox file(s), mounted read-only at /mbox in
# the ingest container.
MBOX_HOST_DIR=./data/mbox

# --- tuning ------------------------------------------------------------------
# Parse worker processes. Empty means os.cpu_count().
GMAIL_ARCHIVE_WORKERS=

# Messages per COPY batch. Empty means the built-in default.
GMAIL_ARCHIVE_BATCH_SIZE=

# --- web ---------------------------------------------------------------------
# Host port for the UI. Published on 127.0.0.1 only; the UI has no
# authentication of its own.
WEB_PORT=8000

GMAIL_ARCHIVE_LOG_LEVEL=INFO

# --- IMAP server ---------------------------------------------------------------
# Password for the read-only IMAP server. Required to start the IMAP server.
# The username defaults to "archive"; set with --user on the CLI.
GMAIL_ARCHIVE_IMAP_PASSWORD=

# --- build metadata (set by the build, not by hand) --------------------------
# Surfaced at /version and by `gmail-archive version`.
GMAIL_ARCHIVE_VERSION=
GMAIL_ARCHIVE_COMMIT=
GMAIL_ARCHIVE_BUILD_TIME=
